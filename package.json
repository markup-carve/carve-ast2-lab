{
  "name": "carve-ast2-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental lab for the Carve AST contract 2.0 design. Not a contract.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/",
    "baseline": "node --experimental-strip-types --no-warnings src/baseline.ts",
    "measure2": "node --experimental-strip-types --no-warnings src/measure2.ts",
    "size": "node --experimental-strip-types --no-warnings src/size-breakdown.ts",
    "consumers": "node --experimental-strip-types --no-warnings src/consumers/measure.ts && node --experimental-strip-types --no-warnings src/consumers/measure-formats.ts",
    "docx:soffice": "node --experimental-strip-types --no-warnings src/consumers/soffice.ts"
  },
  "dependencies": {
    "@markup-carve/carve": "0.1.14",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
